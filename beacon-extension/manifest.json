{
  "manifest_version": 3,
  "name": "Beacon — Sales Navigator Bridge",
  "version": "1.3.0",
  "description": "Pull LinkedIn Sales Navigator leads directly into Beacon.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Beacon Bridge"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/sales/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
